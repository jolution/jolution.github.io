---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import LanguagePicker from '@components/LanguagePicker.astro'
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@i18n/utils'

const currentYear = new Date().getFullYear()
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<footer>
  <section class="py-20">
    <div class="container">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-3">

        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2" aria-label="Jolution">
            <svg
              aria-hidden="true"
              focusable="false"
              width="36"
              height="36"
              viewBox="0 0 400 400"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M200 0A200 200 0 0 0 0 200a200 200 0 0 0 200 200 200 200 0 0 0 200-200 200 200 0 0 0-76.736-157.21l-.028 156.01c0 4.268-.214 8.484-.636 12.64-.422 4.155-1.05 8.25-1.873 12.273-.824 4.023-1.843 7.975-3.047 11.846-1.204 3.87-2.593 7.66-4.157 11.356-1.563 3.697-3.302 7.302-5.205 10.805-1.903 3.504-3.97 6.904-6.19 10.192-2.222 3.288-4.6 6.463-7.118 9.516-2.52 3.052-5.18 5.98-7.977 8.777-2.796 2.796-5.727 5.46-8.78 7.98-3.052 2.518-6.227 4.892-9.515 7.114-3.288 2.22-6.688 4.29-10.19 6.192-3.504 1.903-7.11 3.642-10.806 5.205-3.697 1.564-7.487 2.953-11.357 4.157-3.87 1.203-7.823 2.22-11.846 3.044-4.024.824-8.12 1.45-12.274 1.873-4.156.423-8.372.64-12.64.64-3.914-.005-7.81-.195-11.677-.566-3.867-.372-7.703-.924-11.497-1.653-3.794-.727-7.545-1.633-11.242-2.71-3.696-1.076-7.34-2.324-10.917-3.74-3.577-1.415-7.088-2.997-10.52-4.742-3.435-1.744-6.79-3.65-10.054-5.715-3.267-2.064-6.443-4.285-9.517-6.66s-6.046-4.903-8.904-7.578l28.102-38.64s1.317 1.547 3.84 3.868c1.262 1.16 2.824 2.516 4.676 3.967 1.852 1.452 3.993 3 6.408 4.55 2.415 1.548 5.104 3.096 8.055 4.548 2.952 1.452 6.164 2.808 9.624 3.97 3.46 1.163 7.167 2.133 11.11 2.813 1.97.34 4 .61 6.087.792 2.088.183 4.23.28 6.43.283 2.636 0 5.24-.128 7.81-.38 2.568-.25 5.097-.622 7.583-1.112 2.487-.49 4.93-1.095 7.323-1.812 2.392-.716 4.732-1.545 7.017-2.478 2.285-.933 4.513-1.97 6.678-3.11 2.166-1.137 4.268-2.375 6.3-3.706 2.032-1.332 3.994-2.758 5.88-4.272 1.887-1.513 3.698-3.113 5.427-4.797 1.728-1.684 3.372-3.452 4.93-5.295 1.556-1.843 3.025-3.76 4.398-5.752 1.372-1.99 2.65-4.052 3.826-6.18 1.177-2.126 2.25-4.318 3.218-6.57.966-2.25 1.824-4.562 2.568-6.927.744-2.365 1.374-4.785 1.883-7.252.508-2.466.896-4.983 1.157-7.54.26-2.558.395-5.156.395-7.793l.015-147.084-.045-38.035A200 200 0 0 0 200 0z"
                class="fill-[#22343b] dark:fill-white"
              ></path>
            </svg>
            <span class="text-sm font-bold sm:text-lg">Jolution</span>
          </div>
          <p class="text-sm leading-relaxed">
            {t('footer.description')}
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <p class="font-semibold">{t('footer.contact')}</p>
          <ul class="flex flex-col gap-3">
            <li>
              <Link isExternal href="https://www.instagram.com/jolution" hideIcon>
                <Icon aria-hidden="true" name="lucide:instagram" size={18} class="inline-block align-middle me-2" />
                Instagram
              </Link>
            </li>
            <li>
              <button id="footer-reveal-email-btn" type="button" class="flex items-center gap-2 underline-offset-4 hover:underline">
                <Icon aria-hidden="true" name="lucide:mail" size={18} />
                {t('footer.email')}
              </button>
              <span id="footer-email-reveal" class="hidden" aria-live="polite"></span>
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-4">
          <p class="font-semibold">{t('footer.legal')}</p>
          <ul class="flex flex-col gap-3">
            <li><Link href={translatePath('/impressum')}>{t('footer.imprint')}</Link></li>
            <li><Link href={translatePath('/datenschutz')}>{t('footer.privacy')}</Link></li>
            <li><Link href={translatePath('/agb')}>{t('footer.terms')}</Link></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section class="py-6 border-t border-[var(--border-color-subtle)]">
    <div class="container flex flex-col gap-2 text-sm md:flex-row md:justify-between">
      <p>&copy; {currentYear} jolution</p>
      <LanguagePicker />
    </div>
  </section>
</footer>

<script>
  const btn = document.getElementById('footer-reveal-email-btn')
  const target = document.getElementById('footer-email-reveal')
  const parts = ['julian', '@', 'jolution', '.com']

  btn?.addEventListener('click', () => {
    const email = parts.join('')
    if (target) {
      target.innerHTML = `<a href="mailto:${email}" class="underline">${email}</a>`
      target.classList.remove('hidden')
    }
    btn.classList.add('hidden')
  })
</script>
