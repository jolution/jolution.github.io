---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Contact">
  <PageHeader title="Contact" subtitle="Feel free to reach out - preferably directly on Instagram." bgType="gradient" />
  <section class="my-24">
    <div class="container">
      <div class="mx-auto max-w-xl space-content">
        <Heading level="h2">How to reach me</Heading>
        <p class="text-xl">
          No forms, no bot filters. Just send me a message directly on one of the channels - or reveal my email
          address.
        </p>

        <div class="flex flex-col gap-4">
          <Link
            href="https://www.instagram.com/jolution"
            isButton
            isExternal
            type="primary"
            animateOnHover
            animationType="boop"
          >
            <Icon aria-hidden="true" name="lucide:instagram" size={20} />
            Instagram
          </Link>
          <button id="reveal-email-btn" type="button" aria-expanded="false" aria-controls="email-reveal">
            <Icon aria-hidden="true" name="lucide:mail" size={20} />
            Show email address
          </button>
          <a id="email-reveal" class="hidden" aria-live="polite"></a>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>

<script>
  const btn = document.getElementById('reveal-email-btn')
  const target = document.getElementById('email-reveal') as HTMLAnchorElement | null
  const parts = ['info', '@', 'jolution', '.de']

  btn?.addEventListener('click', () => {
    const email = parts.join('')
    if (target) {
      target.href = `mailto:${email}`
      target.textContent = email
      target.classList.remove('hidden')
    }
    btn.setAttribute('aria-expanded', 'true')
    btn.classList.add('hidden')
  })
</script>
