---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import { Heading, Link } from 'accessible-astro-components'

const yearsSinceFoundation = new Date().getFullYear() - 2013
---

<DefaultLayout title="Jolution - Projects, Ideas and Experiments" useTitleTemplate={false}>
  <Hero />
  <section class="my-32">
    <div class="container">
      <Heading level="h2" class="mb-8">About Jolution</Heading>
      <p class="max-w-3xl text-xl leading-relaxed">
        Jolution was founded {yearsSinceFoundation} years ago, in August 2013, to build projects, prototypes, and
        product ideas.<br /><br />Everything now lives on jolution.com: first own ideas and products, complemented by a
        compact snapshot of selected client projects.
      </p>
      <div class="mt-8">
        <Link href="#projekte" isButton type="secondary" animateOnHover animationType="boop">
          View projects
        </Link>
      </div>
    </div>
  </section>
  <section class="my-64">
    <div class="container">
      <Heading level="h2" class="mb-8">Jolution in 9 Things</Heading>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        <Feature icon="lucide:monitor-smartphone" title="Frontend">
          Jolution builds at the intersection of idea, interface, and working product.
        </Feature>
        <Feature icon="lucide:package" title="Own Tools">
          Many projects start from real day-to-day friction and become small tools with practical value.
        </Feature>
        <Feature icon="lucide:github" title="Open Source">
          On GitHub, Jolution is open, experimental, and product-focused with repositories meant to be used.
        </Feature>
        <Feature icon="lucide:wand-sparkles" title="Prototyping">
          New ideas are tested early instead of being planned theoretically for too long.
        </Feature>
        <Feature icon="lucide:workflow" title="Developer Experience">
          A key focus is workflows, automation, and tools that make development easier.
        </Feature>
        <Feature icon="lucide:puzzle" title="Extensions">
          Browser and VS Code extensions are as important as classic websites and apps.
        </Feature>
        <Feature icon="lucide:rocket" title="Pragmatic">
          What matters is not show, but whether an idea is implemented cleanly and holds up in daily use.
        </Feature>
        <Feature icon="lucide:users" title="Community">
          Feedback, issues, pull requests, and visible progress are core parts of project culture.
        </Feature>
        <Feature icon="lucide:heart" title="Long-term">
          Jolution is not a short-term showcase, but a framework for things that can grow over years.
        </Feature>
      </div>
    </div>
  </section>
  <section class="my-32">
    <div class="container">
      <Heading level="h2" class="mb-8">What this site is</Heading>
      <p class="max-w-3xl text-xl leading-relaxed">
        This site mainly shows current Jolution projects: open-source tools, browser and VS Code extensions,
        developer workflows, and prototypes. These include TODO NUKEM, LeCheckout for Jira, GitBrush, Blocky, and
        experiments around GitHub Actions and microcontrollers.<br /><br />

        Priority remains clearly on ideas, prototypes, and own products. In addition, two client projects are shown in
        a small and intentional snapshot.
      </p>
    </div>
  </section>
  <div id="projekte">
    <FeaturedProjects />
    <section class="mt-16">
      <div class="container">
        <Heading level="h3" class="mb-6">Client Topics in Small Scope</Heading>
        <p class="max-w-3xl leading-relaxed">
          Three selected client projects, shown only as a small snapshot without public detail pages:
          Workfield (employee time tracking), picman (browser extension), and the
          <strong>Tour Planner</strong> — an Angular web application for planning and managing tours.
        </p>
        <div class="mt-6 grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-3">
          <article>
            <img
              src="/projects/workfield-featured.webp"
              alt="Screenshot of client project Workfield"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-contain"
            />
            <p class="mt-3 text-sm">Workfield</p>
            <p class="text-sm">Employee time tracking web application</p>
          </article>
          <article>
            <img
              src="/projects/picman-featured.webp"
              alt="Screenshot of client project picman"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-contain"
            />
            <p class="mt-3 text-sm">picman</p>
            <p class="text-sm">Browser extension for rolling order picking</p>
          </article>
          <article>
            <img
              src="/projects/tourplaner-angular-featured.webp"
              alt="Tour Planner logo for the client project"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-contain"
            />
            <p class="mt-3 text-sm">Tour Planner</p>
            <p class="text-sm">Angular web application for route planning</p>
          </article>
        </div>
        <div class="mt-8">
          <button
            id="project-reveal-email-btn"
            type="button"
            class="button button--filled type-secondary button--md"
          >
            Request a project via email
          </button>
          <a id="project-email-reveal" class="hidden mt-3 block" aria-live="polite"></a>
        </div>
      </div>
    </section>
  </div>
</DefaultLayout>

<script>
  const btn = document.getElementById('project-reveal-email-btn')
  const target = document.getElementById('project-email-reveal') as HTMLAnchorElement | null
  const parts = ['julian', '@', 'jolution', '.com']
  btn?.addEventListener('click', () => {
    const email = parts.join('')
    if (target) {
      target.href = `mailto:${email}`
      target.textContent = email
      target.classList.remove('hidden')
    }
    btn.classList.add('hidden')
  })
</script>
