---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import { Link } from 'accessible-astro-components'
---

<DefaultLayout title="Projects" description="Overview of the current Jolution projects." noindex={true}>
  <PageHeader
    title="Projects"
    subtitle="Browse the current Jolution projects as standalone portfolio pages instead of a homepage anchor."
    bgType="bordered"
  />

  <section class="mt-8">
    <div class="container">
      <Link href="/en/" isButton type="secondary" animateOnHover animationType="boop">Back to home</Link>
    </div>
  </section>

  <FeaturedProjects class="my-12" title="Project Overview" />
</DefaultLayout>
