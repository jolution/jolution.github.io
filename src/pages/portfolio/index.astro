---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import { Link } from 'accessible-astro-components'
---

<DefaultLayout title="Projekte" description="Übersicht der aktuellen Jolution-Projekte." noindex={true}>
  <PageHeader
    title="Projekte"
    subtitle="Direkter Einstieg in die Jolution-Projekte ohne Weiterleitung auf die Startseiten-Sprungmarke."
    bgType="bordered"
  />

  <section class="mt-8">
    <div class="container">
      <Link href="/" isButton type="secondary" animateOnHover animationType="boop">Zur Startseite</Link>
    </div>
  </section>

  <FeaturedProjects class="my-12" title="Projektübersicht" />
</DefaultLayout>
