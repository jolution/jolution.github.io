---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import { Heading, Link } from 'accessible-astro-components'

const yearsSinceFoundation = new Date().getFullYear() - 2013
---

<DefaultLayout title="Jolution - Projekte, Ideen und Experimente" useTitleTemplate={false}>
  <Hero />
  <section class="my-32">
    <div class="container">
      <Heading level="h2" class="mb-8">Über Jolution</Heading>
      <p class="max-w-3xl text-xl leading-relaxed">
        Jolution wurde vor {yearsSinceFoundation} Jahren, im August 2013, gegründet, um Projekte zu realisieren,
        Prototypen zu bauen und Ideen zu entwickeln.<br /><br />Heute läuft alles auf jolution.com zusammen: zuerst
        die eigenen Ideen und Produkte, ergänzt um ausgewählte Kundenprojekte als kompakter Ausschnitt.
      </p>
      <div class="mt-8">
        <Link href="#projekte" isButton type="secondary" animateOnHover animationType="boop">
          Projekte anzeigen
        </Link>
      </div>
    </div>
  </section>
  <section class="my-64">
    <div class="container">
      <Heading level="h2" class="mb-8">
        <span class="md:hidden">Jolution in 3 Dingen</span>
        <span class="hidden md:inline">Jolution in 9 Dingen</span>
      </Heading>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        <Feature icon="lucide:monitor-smartphone" title="Frontend">
          Jolution baut vor allem an der Schnittstelle zwischen Idee, Interface und funktionierendem Produkt.
        </Feature>
        <Feature icon="lucide:package" title="Eigene Tools">
          Viele Projekte entstehen aus konkreten Reibungen im Alltag und werden zu kleinen Tools mit echtem Nutzen.
        </Feature>
        <Feature icon="lucide:github" title="Open Source">
          Auf GitHub zeigt sich Jolution offen, experimentell und produktnah mit Repositories, die wirklich benutzt
          werden sollen.
        </Feature>
        <div class="hidden md:contents">
          <Feature icon="lucide:wand-sparkles" title="Prototyping">
            Neue Ideen werden lieber früh ausprobiert als lange theoretisch geplant.
          </Feature>
          <Feature icon="lucide:workflow" title="Developer Experience">
            Ein Schwerpunkt liegt auf Workflows, Automatisierung und Werkzeugen, die Entwicklungsarbeit einfacher machen.
          </Feature>
          <Feature icon="lucide:puzzle" title="Extensions">
            Browser- und VS-Code-Erweiterungen gehören genauso dazu wie klassische Websites und Apps.
          </Feature>
          <Feature icon="lucide:rocket" title="Pragmatisch">
            Entscheidend ist nicht Show, sondern ob eine Idee sauber umgesetzt ist und im Alltag trägt.
          </Feature>
          <Feature icon="lucide:users" title="Community">
            Feedback, Issues, Pull Requests und sichtbare Weiterentwicklung sind ein fester Teil der Projektkultur.
          </Feature>
          <Feature icon="lucide:heart" title="Langfristig">
            Jolution ist kein kurzfristiges Showcase, sondern ein Rahmen für Dinge, die über Jahre weiterwachsen dürfen.
          </Feature>
        </div>
      </div>
    </div>
  </section>
  <section class="my-32">
    <div class="container">
      <Heading level="h2" class="mb-8">Was diese Seite ist</Heading>
      <p class="max-w-3xl text-xl leading-relaxed">
        Hier zeige ich vor allem die aktuellen Jolution-Projekte: Open-Source-Tools, Browser- und VS-Code-Extensions,
        Developer-Workflows und Prototypen. Dazu gehören unter anderem TODO NUKEM, LeCheckout for Jira, GitBrush,
        Blocky sowie Experimente rund um GitHub Actions und Mikrocontroller.<br /><br />

        Die Priorität liegt weiterhin klar auf Ideen, Prototypen und eigenen Produkten. Ergänzend zeige ich in kleiner
        Form zwei Kundenprojekte, bewusst nur als Ausschnitt.
      </p>
    </div>
  </section>
  <div id="projekte">
    <FeaturedProjects />
    <section class="mt-16">
      <div class="container">
        <Heading level="h3" class="mb-6">Projekte mit Kundenbezug</Heading>
        <p class="max-w-3xl leading-relaxed">
          Drei ausgewählte Kundenprojekte, bewusst nur als kleiner Ausschnitt ohne öffentliche Detailseiten:
          Workfield (Mitarbeiterstundenerfassung), picman (Browser Extension) sowie der
          <strong>Tourplaner</strong> — eine Angular-Webanwendung zur Planung und Verwaltung von Touren.
        </p>
        <div class="mt-6 grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-3">
          <article>
            <img
              src="/projects/workfield-featured.webp"
              alt="Screenshot des Kundenprojekts Workfield"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-contain"
            />
            <p class="mt-3 text-sm">Workfield</p>
            <p class="text-sm">Mitarbeiterstundenerfassung Web-Application</p>
          </article>
          <article>
            <img
              src="/projects/picman-featured.webp"
              alt="Screenshot des Kundenprojekts picman"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-contain"
            />
            <p class="mt-3 text-sm">picman</p>
            <p class="text-sm">Browser Extension für rollende Kommissionierung</p>
          </article>
          <article>
            <img
              src="/projects/tourplaner-angular-featured.webp"
              alt="Tourplaner-Logo für das Kundenprojekt"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-contain"
            />
            <p class="mt-3 text-sm">Tourplaner</p>
            <p class="text-sm">Angular-Webanwendung zur Tourenplanung</p>
          </article>
        </div>
        <div class="mt-8">
          <button
            id="project-reveal-email-btn"
            type="button"
            class="button button--filled type-secondary button--md"
          >
            Projekt anfragen per E-Mail
          </button>
          <a id="project-email-reveal" class="hidden mt-3 block" aria-live="polite"></a>
        </div>
      </div>
    </section>
  </div>
</DefaultLayout>

<script>
  const btn = document.getElementById('project-reveal-email-btn')
  const target = document.getElementById('project-email-reveal') as HTMLAnchorElement | null
  const parts = ['julian', '@', 'jolution', '.com']
  btn?.addEventListener('click', () => {
    const email = parts.join('')
    if (target) {
      target.href = `mailto:${email}`
      target.textContent = email
      target.classList.remove('hidden')
    }
    btn.classList.add('hidden')
  })
</script>
